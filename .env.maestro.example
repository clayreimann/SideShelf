# Maestro UI test credentials
# Copy this file to .env.maestro and fill in real values.
# .env.maestro is gitignored -- never commit real credentials.
#
# For SCREENSHOTS (npm run screenshots), point this at the local demo server
# rather than a personal library -- its content is public-domain LibriVox audio,
# so no copyrighted cover art ends up in App Store or marketing images:
#
#   npm run demo:up && npm run demo:seed
#
# then use the DEMO_USERNAME / DEMO_PASSWORD values from demo-server/.env.
# The iOS Simulator reaches the host's loopback directly, so 127.0.0.1 works.
MAESTRO_SERVER_URL=http://127.0.0.1:13378
MAESTRO_USERNAME=demo-reviewer
MAESTRO_PASSWORD=your-demo-password

# For REGRESSION FLOWS (npm run maestro:test) you may prefer a real server:
# MAESTRO_SERVER_URL=http://your-abs-server.local:13378
# MAESTRO_USERNAME=your-username
# MAESTRO_PASSWORD=your-password
