# Copy this file to demo-server/.env and fill in real values.
# demo-server/.env is gitignored — never commit it.

# Pin to one of the two releaseTestVersions from the compatibility manifest
# (docs/superpowers/plans/2026-07-27-audiobookshelf-api-compatibility.md,
# Task 1): "2.28.0" (oldest supported / minimumServerVersion) or "2.35.1"
# (current). Both must work against this same demo-server setup.
ABS_VERSION=2.35.1

# Host port the container's port 80 is published to, bound to 127.0.0.1 only
# (see demo-server/compose.yml). Change only if 13378 is already in use.
ABS_PORT=13378

# Root user created by seed.mjs via POST /init on first run. Throwaway
# credentials only — see demo-server/README.md.
ABS_ROOT_USERNAME=demo-admin
ABS_ROOT_PASSWORD=change-me-root

# Non-root user created by seed.mjs — this is the account App Review logs
# in with. Its password ships in App Review notes, so it must be a
# throwaway with no reuse anywhere else. See demo-server/README.md.
DEMO_USERNAME=demo-reviewer
DEMO_PASSWORD=change-me-demo
